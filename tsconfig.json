{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": [
      "es2020"
    ],
    "outDir": "./build",
    "rootDir": ".",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "inlineSourceMap": true
  },
  "include": [
    "src",
    "test/**/*"
  ],
  "exclude": [
    "node_modules",
    "build"
  ]
}
